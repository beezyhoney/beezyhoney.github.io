---
// Inline SVG icon (see src/admin/icons.ts). Decorative by default; pass `label` when the icon alone carries meaning.
import { ICONS, type IconName } from '../icons';

interface Props {
  name: IconName;
  label?: string;
  size?: number;
  class?: string;
}
const { name, label, size, class: cls } = Astro.props;
const style = size ? `width:${size}px;height:${size}px` : undefined;
---
<svg
  class:list={['ico', cls]}
  viewBox="0 0 24 24"
  style={style}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={ICONS[name]}
></svg>
