---
// One bar split into parts that add up to 100%, with a key that names every part and its number (colour is never the
// only signal). Use it for "what kind of products" or "where orders come from".
//   <StackBar label="Where orders come from" parts={[{ label: 'WhatsApp', value: '₹9,000', share: 60 }, { label: 'Phone', value: '₹6,000', share: 40 }]} />
interface Part {
  label: string;
  /** the number, already written */
  value: string;
  /** share of the whole, 0–100 */
  share: number;
}
interface Props {
  parts: Part[];
  /** screen-reader name of the bar */
  label: string;
  class?: string;
}
const { parts, label, class: cls } = Astro.props;
const total = parts.reduce((s, p) => s + Math.max(0, p.share), 0);
const pctText = (s: number) => `${total > 0 ? Math.round((s * 100) / total) : 0}%`;
---
<div class:list={['stack', cls]}>
  <div class="stack-bar" role="img" aria-label={`${label}: ${parts.map((p) => `${p.label} ${pctText(p.share)}`).join(', ')}`}>
    {parts.filter((p) => p.share > 0).map((p, i) => <span class={`seg seg-${(i % 6) + 1}`} style={`flex:${p.share} 1 0`}></span>)}
  </div>
  <ul class="stack-key">
    {parts.map((p, i) => (
      <li>
        <span class={`swatch-dot seg-${(i % 6) + 1}`} aria-hidden="true"></span>
        <span class="stack-text">
          <span class="stack-name">{p.label}</span>
          <span class="stack-meta"><span class="stack-value">{p.value}</span> · <span class="stack-pct">{pctText(p.share)}</span></span>
        </span>
      </li>
    ))}
  </ul>
</div>
