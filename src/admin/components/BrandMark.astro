---
// The official Beezy Honey seal on a round paper plate, so the dark linework reads on the chocolate side menu.
// The pictures are the owner's logo files (src/assets/img/logo-seal-square.png), only resized for the admin
// (src/admin/assets/brand-seal-128.webp for menus, brand-seal-256.webp for the login page). No drawn stand-in.
import seal128 from '../assets/brand-seal-128.webp?url';
import seal256 from '../assets/brand-seal-256.webp?url';

interface Props {
  class?: string;
  /** the bigger picture for the login page */
  large?: boolean;
}
const { class: cls, large } = Astro.props;
---
<span class:list={['brand-mark', { 'is-large': large }, cls]}>
  <img src={large ? seal256 : seal128} width="128" height="128" alt="" decoding="async" />
</span>
