---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { GUIDES, guideHref } from '../../data/guides';
import { SITE, link } from '../../data/site';
import { img } from '../../lib/images';
import { toJson } from '../../lib/json';

const description = 'Plain, honest honey guides from Beezy Honey: murungai honey, how to check if honey is pure, eating honey with comb, and rare Neela Kurinji honey.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(link('/'), Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Honey guides',
  description,
  url: canonical,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: home },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: GUIDES.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.h1, url: new URL(guideHref(g.slug), Astro.site).href })),
  },
};
---
<Base title="Honey Guides" page="guides" description={description}>
  <script slot="head" type="application/ld+json" set:html={toJson(ld)} />

  <section class="page-top wrap gi-head">
    <h1 class="t-giant page-title" data-split="chars" data-now>Guides</h1>
    <p class="t-lead">Plain, honest answers to the questions we hear most about honey: what one flower changes, how to judge a jar, how to eat the comb, and why some honeys are rare.</p>
  </section>

  <section class="wrap gi-list" aria-label="All guides">
    <ol class="gi-grid">
      {GUIDES.map((g, i) => (
        <li>
          <a class="gi-card" href={guideHref(g.slug)}>
            <div class="gi-photo">
              <Image src={img(g.image)} alt={g.alt} widths={[480, 760, 1100]} sizes="(max-width: 760px) calc(100vw - 32px), 45vw" loading={i < 2 ? 'eager' : 'lazy'} style={`object-position:${g.position ?? '50% 50%'}`} />
            </div>
            <div class="gi-text">
              <span class="eyebrow">{g.eyebrow}</span>
              <h2 class="gi-title">{g.h1}</h2>
              <span class="gi-dek">{g.dek}</span>
              <span class="gi-more">Read the guide <Icon name="arrow-right" /></span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap gi-tools" aria-label="Helpful tools">
    <p>Looking for something else? Find the honey that suits your taste with the <a href={link('/honey-finder/')}>Honey Finder</a>, see when each flower blooms on the <a href={link('/harvest/#bloom-calendar')}>bloom calendar</a>, or look up the batch number on your label with <a href={link('/know-your-jar/')}>Know Your Jar</a>.</p>
  </section>
</Base>

<style>
  .gi-head { display: grid; justify-items: center; gap: 28px; text-align: center; }
  .gi-head .t-lead { max-width: 36ch; }
  .gi-list { padding-top: clamp(50px, 7vw, 100px); }
  .gi-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 36px); max-width: 1240px; margin-inline: auto; }
  .gi-card { height: 100%; display: grid; grid-template-rows: auto 1fr; border-radius: var(--radius); overflow: hidden; background: var(--paper); border: 1px solid var(--rule); text-decoration: none; color: var(--choc); transition: box-shadow .4s var(--ease), transform .5s var(--ease); }
  .gi-card:hover { transform: translateY(-3px); box-shadow: 0 24px 50px rgba(43, 26, 16, .12); }
  .gi-photo { display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--cream-2); }
  .gi-photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .9s var(--ease); }
  .gi-card:hover .gi-photo :global(img) { transform: scale(1.04); }
  .gi-text { display: grid; align-content: start; gap: 12px; padding: clamp(20px, 2.6vw, 34px); }
  .gi-title { font-family: var(--f-display); font-weight: 500; font-size: clamp(1.6rem, 2.6vw, 2.3rem); line-height: 1.1; text-wrap: balance; }
  .gi-dek { color: var(--ink-2); }
  .gi-more { display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--honey-deep); }
  .gi-more :global(svg) { width: 18px; height: 18px; transition: transform .5s var(--ease); }
  .gi-card:hover .gi-more :global(svg) { transform: translateX(4px); }
  .gi-tools { padding-top: clamp(50px, 7vw, 100px); }
  .gi-tools p { max-width: 640px; margin-inline: auto; text-align: center; color: var(--ink-2); }
  .gi-tools a { color: var(--honey-deep); font-weight: 600; text-underline-offset: 3px; }
  @media (max-width: 760px) {
    .gi-grid { grid-template-columns: 1fr; }
  }
</style>
