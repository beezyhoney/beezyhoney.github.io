---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { PRODUCTS } from '../data/products';
import { SITE, link } from '../data/site';
import { img } from '../lib/images';

const n = PRODUCTS.length;
const first = PRODUCTS[0];
const data = PRODUCTS.map((p) => ({ name: p.name, kind: p.kind, href: link(`/shop/${p.slug}/`) }));
---
<section class="carousel" data-carousel aria-roledescription="carousel" aria-label="Beezy Honey products">
  <h1 class="sr-only">Beezy Honey: raw comb honey, wild honey and beeswax from {SITE.farm}, since {SITE.established}</h1>

  <div class="disc" aria-hidden="true">
    <svg class="ring" viewBox="0 0 1000 1000">
      <defs><path id="ring-path" d="M 500 500 m -430 0 a 430 430 0 1 1 860 0 a 430 430 0 1 1 -860 0" /></defs>
      <circle cx="500" cy="500" r="360" fill="none" stroke="currentColor" stroke-opacity=".25" stroke-width="2" />
      <g class="ring-spin">
        <text><textPath href="#ring-path" textLength="2700" lengthAdjust="spacing">RAW · REAL · UNPASTEURISED · STRAIGHT FROM THE HIVE ·</textPath></text>
      </g>
    </svg>
  </div>

  <ul class="slides">
    {PRODUCTS.map((p, i) => (
      <li class="slide" data-slide aria-roledescription="slide" aria-label={`${i + 1} of ${n}: ${p.name}`}>
        <a class="slide-card" href={link(`/shop/${p.slug}/`)} tabindex={i === 0 ? 0 : -1} style={`--tone:${p.tone}`}>
          <Image src={img(p.photo)} alt={p.name} widths={[480, 800, 1000]} sizes="(max-width: 760px) 76vw, 32vw" loading={i < 3 || i > n - 3 ? 'eager' : 'lazy'} />
        </a>
      </li>
    ))}
  </ul>

  <div class="caption">
    <div class="cap-mask">
      <div class="cap-track" aria-live="polite">
        <div class="cap-item">
          <p class="cap-kind" data-cap-kind>{first.kind}</p>
          <h2 class="cap-name"><a data-cap-link href={link(`/shop/${first.slug}/`)}>{first.name}</a></h2>
        </div>
      </div>
    </div>
    <div class="controls">
      <button type="button" class="round" data-prev aria-label="Previous product"><Icon name="arrow-left" /></button>
      <span class="counter"><b data-index>01</b> / {String(n).padStart(2, '0')}</span>
      <button type="button" class="round" data-next aria-label="Next product"><Icon name="arrow-right" /></button>
    </div>
  </div>

  <p class="scroll-hint" aria-hidden="true">Scroll to discover</p>
</section>
<script type="application/json" id="carousel-data" set:html={JSON.stringify(data)} />

<style>
  .carousel { position: relative; isolation: isolate; height: 100svh; min-height: 560px; overflow: hidden; color: var(--choc); touch-action: none; }
  .disc {
    --size: max(118vmin, 82vh);
    position: absolute; left: 50%; top: 44%;
    width: var(--size); aspect-ratio: 1; translate: -50% 0;
    border-radius: 50%; background: var(--cocoa); color: var(--honey);
  }
  .ring { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring text { font-family: var(--f-display); font-size: 66px; letter-spacing: .02em; fill: currentColor; }
  .ring-spin { transform-origin: 500px 500px; animation: spin 80s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .slides { position: absolute; inset: 0; }
  .slide {
    --size: min(40svh, 32vw, 480px);
    position: absolute; left: 50%; top: 42%;
    width: var(--size); aspect-ratio: 1;
    translate: -50% -50%;
    will-change: transform;
  }
  .slide-card { display: block; width: 100%; height: 100%; border-radius: var(--radius-photo); overflow: hidden; background: var(--tone); box-shadow: 0 40px 70px rgba(43, 26, 16, .35); }
  .slide-card :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .slide-card:hover :global(img) { transform: scale(1.05); }

  .caption { position: absolute; left: 0; right: 0; bottom: max(64px, 9svh); display: grid; justify-items: center; gap: 14px; text-align: center; color: var(--cream); z-index: 120; pointer-events: none; }
  .caption > * { pointer-events: auto; }
  .cap-mask { overflow: clip; padding: 4px 16px; }
  .cap-track { display: grid; }
  .cap-item { grid-area: 1 / 1; will-change: transform; }
  .cap-kind { font-size: .76rem; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--amber); }
  .cap-name { font-family: var(--f-display); font-weight: 400; font-size: clamp(2rem, 4.2vw, 3.6rem); line-height: 1.05; }
  .cap-name a { text-decoration: none; }
  .cap-name a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; }
  .controls { display: flex; align-items: center; gap: 16px; }
  .controls .round { border-color: rgba(251, 243, 230, .5); color: var(--cream); width: 46px; height: 46px; }
  .controls .round:hover { background: var(--cream); color: var(--choc); }
  .counter { font-family: var(--f-display); font-size: 1.05rem; font-variant-numeric: tabular-nums; min-width: 5.5ch; }
  .counter b { font-weight: 400; color: var(--amber); }
  .scroll-hint { position: absolute; left: 50%; bottom: 20px; translate: -50% 0; font-size: .74rem; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--cream); opacity: .8; z-index: 120; white-space: nowrap; }

  @media (max-width: 760px) {
    .slide { --size: min(38svh, 76vw, 360px); top: 40%; }
    .caption { bottom: 64px; }
    .scroll-hint { bottom: 26px; left: var(--gutter); translate: none; }
  }
</style>

<script>
  import { gsap, onReady, reducedMotion } from '../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const data: { name: string; kind: string; href: string }[] = JSON.parse(document.getElementById('carousel-data')!.textContent!);
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const links = slides.map((s) => s.querySelector<HTMLAnchorElement>('a')!);
    const ring = root.querySelector<SVGElement>('.ring')!;
    const capTrack = root.querySelector<HTMLElement>('.cap-track')!;
    let capItem = root.querySelector<HTMLElement>('.cap-item')!;
    const counter = root.querySelector<HTMLElement>('[data-index]')!;
    const n = slides.length;
    const state = { p: 0 };
    let current = 0;
    let busy = false;
    let ready = false;
    let queued = 0;
    let capTl: gsap.core.Timeline | null = null;
    const html = document.documentElement;

    const layout = () => {
      const w = window.innerWidth;
      const card = slides[0].offsetWidth;
      const spacing = w < 760 ? card * 0.92 : card * 1.12;
      slides.forEach((el, i) => {
        let d = (((i - state.p) % n) + n) % n;
        if (d > n / 2) d -= n;
        const a = Math.abs(d);
        gsap.set(el, {
          x: d * spacing,
          y: a * a * 26 + a * 20,
          rotation: d * 12,
          scale: 1 - Math.min(a, 2.5) * 0.19,
          autoAlpha: a > 2.6 ? 0 : 1,
          zIndex: 100 - Math.round(a * 10),
        });
      });
      gsap.set(ring, { rotation: -state.p * (360 / n) });
    };

    // The name rolls like a ticker: the old name moves up and out while the new one moves up into
    // place at the same time (down when going back), so there is never a moment without a name.
    const showCaption = (i: number, dir: number) => {
      const d = data[i];
      counter.textContent = String(i + 1).padStart(2, '0');
      links.forEach((l, k) => (l.tabIndex = k === i ? 0 : -1));
      capTl?.progress(1).kill();
      const prev = capItem;
      const next = prev.cloneNode(true) as HTMLElement;
      next.querySelector('[data-cap-kind]')!.textContent = d.kind;
      const a = next.querySelector<HTMLAnchorElement>('[data-cap-link]')!;
      a.textContent = d.name;
      a.href = d.href;
      prev.setAttribute('aria-hidden', 'true');
      prev.querySelector('a')!.tabIndex = -1;
      capTrack.append(next);
      capItem = next;
      if (reducedMotion()) { prev.remove(); return; }
      capTl = gsap.timeline({ onComplete: () => prev.remove() })
        .fromTo(next, { yPercent: dir * 110 }, { yPercent: 0, duration: 0.95, ease: 'power3.inOut' }, 0)
        .to(prev, { yPercent: -dir * 110, duration: 0.95, ease: 'power3.inOut' }, 0);
    };

    // queue: arrow buttons and keys remember one extra press made during a move; scrolling never queues
    const go = (dir: number, queue = true) => {
      if (!ready || html.classList.contains('is-menu-open') || html.classList.contains('is-cart-open')) return;
      if (busy) { if (queue) queued = dir; return; }
      busy = true;
      const target = Math.round(state.p) + dir;
      current = ((target % n) + n) % n;
      showCaption(current, dir);
      gsap.to(state, {
        p: target, duration: reducedMotion() ? 0 : 0.95, ease: 'power3.inOut',
        onUpdate: layout,
        onComplete: () => {
          busy = false;
          if (queued) { const next = queued; queued = 0; go(next); }
        },
      });
    };

    layout();
    window.addEventListener('resize', layout);
    root.querySelector('[data-prev]')!.addEventListener('click', () => go(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(1));
    document.addEventListener('keydown', (e) => {
      if (e.repeat || (e.target as HTMLElement).closest('input, textarea, .menu, .cart')) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); go(1); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); go(-1); }
    });

    // Mouse wheel and touchpad: one scroll moves exactly one product. A single scroll arrives as a
    // stream of wheel events (several wheel clicks, or a touchpad flick with its slow inertia tail).
    // Only an event after a real pause starts a new scroll; everything else in the stream is ignored.
    const PAUSE = 380;
    let lastWheel = -Infinity;
    root.addEventListener('wheel', (e) => {
      e.preventDefault();
      const now = performance.now();
      const pause = now - lastWheel;
      lastWheel = now;
      const delta = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
      if (busy || pause < PAUSE || Math.abs(delta) < 2) return;
      go(delta > 0 ? 1 : -1, false);
    }, { passive: false });

    // Touch: one swipe (up or left = next) moves one product, decided when the finger lifts
    let touchStart: { x: number; y: number } | null = null;
    root.addEventListener('touchstart', (e) => { touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY }; }, { passive: true });
    root.addEventListener('touchmove', (e) => { if (touchStart) e.preventDefault(); }, { passive: false });
    root.addEventListener('touchend', (e) => {
      if (!touchStart) return;
      const t = e.changedTouches[0];
      const dx = touchStart.x - t.clientX;
      const dy = touchStart.y - t.clientY;
      touchStart = null;
      const d = Math.abs(dx) > Math.abs(dy) ? dx : dy;
      if (Math.abs(d) > 40) go(d > 0 ? 1 : -1, false);
    });

    onReady(() => {
      ready = true;
      if (reducedMotion()) return;
      gsap.timeline()
        .from('.disc', { scale: 0.7, autoAlpha: 0, duration: 1.4, ease: 'expo.out' }, 0)
        .from(slides.map((s) => s.querySelector('.slide-card')), { yPercent: 60, autoAlpha: 0, duration: 1.3, ease: 'expo.out', stagger: 0.05 }, 0.15)
        .from('.controls, .scroll-hint', { autoAlpha: 0, duration: 0.8 }, 0.9);
      capTl = gsap.timeline({ delay: 0.6 }).fromTo(capItem, { yPercent: 110 }, { yPercent: 0, duration: 0.9, ease: 'expo.out' });
    });
  }
</script>
