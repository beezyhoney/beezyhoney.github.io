---
// A photo with a caption inside a guide's text (src/layouts/Guide.astro styles it). Local photos only.
import { Image } from 'astro:assets';
import { img } from '../lib/images';

interface Props {
  /** file in src/assets/img */
  src: string;
  alt: string;
  caption: string;
  /** wide 3:2 (default), tall 4:5 or square */
  shape?: 'wide' | 'tall' | 'square';
  /** CSS object-position */
  position?: string;
}
const { src, alt, caption, shape = 'wide', position = '50% 50%' } = Astro.props;
---
<figure class={`g-fig ${shape}`}>
  <div class="g-fig-photo">
    <Image src={img(src)} alt={alt} widths={[480, 760, 1100]} sizes="(max-width: 760px) calc(100vw - 32px), 720px" style={`object-position:${position}`} />
  </div>
  <figcaption>{caption}</figcaption>
</figure>
