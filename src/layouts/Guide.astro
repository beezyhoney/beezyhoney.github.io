---
// One guide article (/guides/<slug>/). The page passes its slug and writes the article text as the default slot
// (plain HTML: <p>, <h2>, <h3>, lists, <GuideFigure>, <aside class="g-note">, <div class="g-table"><table>).
// Everything else comes from src/data/guides.ts: title, meta description, H1, main photo, dates, products.
import { Image, getImage } from 'astro:assets';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { GUIDES, guideHref, longDate } from '../data/guides';
import { PRODUCT_PAGES, type Product } from '../data/products';
import { SITE, link } from '../data/site';
import { img } from '../lib/images';
import { toJson } from '../lib/json';

interface Props { slug: string }
const { slug } = Astro.props;
const g = GUIDES.find((x) => x.slug === slug);
if (!g) throw new Error(`Guide "${slug}" is not listed in src/data/guides.ts`);
if (Astro.url.pathname !== guideHref(slug)) throw new Error(`Guide "${slug}" is served at ${Astro.url.pathname}; rename the page file to match the slug`);

// The article text, rendered once: shown below, and measured for the reading time and the structured data.
const body = await Astro.slots.render('default');
const words = body.replace(/<[^>]*>/g, ' ').replace(/&[#a-z0-9]+;/gi, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(link('/'), Astro.site).href;
// a JPEG for social previews and search results (some apps do not show WebP previews)
const share = await getImage({ src: img(g.image), width: 1200, format: 'jpeg' });
const shareUrl = new URL(share.src, Astro.site).href;
const related = g.products.map((s) => PRODUCT_PAGES.find((p) => p.slug === s)).filter((p): p is Product => !!p);
const others = GUIDES.filter((x) => x.slug !== slug);

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${canonical}#article`,
      headline: g.h1,
      description: g.description,
      image: [shareUrl],
      datePublished: g.published,
      dateModified: g.updated,
      inLanguage: 'en',
      wordCount: words,
      articleSection: 'Guides',
      mainEntityOfPage: canonical,
      author: { '@type': 'Organization', name: SITE.name, url: home },
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        url: home,
        logo: { '@type': 'ImageObject', url: new URL(link('/apple-touch-icon.png'), Astro.site).href },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: home },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL(link('/guides/'), Astro.site).href },
        { '@type': 'ListItem', position: 3, name: g.short, item: canonical },
      ],
    },
  ],
};
---
<Base title={g.title} description={g.description} page="guides" ogType="article" ogImage={share.src}>
  <script slot="head" type="application/ld+json" set:html={toJson(ld)} />
  <meta slot="head" property="article:published_time" content={g.published} />
  <meta slot="head" property="article:modified_time" content={g.updated} />

  <article class="guide" aria-labelledby="guide-title">
    <header class="g-head page-top wrap">
      <nav class="g-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={link('/')}>Home</a></li>
          <li><a href={link('/guides/')}>Guides</a></li>
          <li><span aria-current="page">{g.short}</span></li>
        </ol>
      </nav>
      <p class="eyebrow">{g.eyebrow}</p>
      <h1 id="guide-title" class="t-giant g-title" data-split="lines" data-now>{g.h1}</h1>
      <p class="t-lead g-dek">{g.dek}</p>
      <p class="g-meta">By {SITE.name} · <time datetime={g.updated}>{longDate(g.updated)}</time> · {minutes} min read</p>
    </header>

    <figure class="g-hero wrap">
      <div class="g-hero-photo">
        <Image src={img(g.image)} alt={g.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 760px) 100vw, min(1120px, 94vw)" loading="eager" fetchpriority="high" style={`object-position:${g.position ?? '50% 50%'}`} />
      </div>
    </figure>

    <div class="g-body wrap">
      <div class="prose"><Fragment set:html={body} /></div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="g-shop wrap" aria-labelledby="g-shop-title">
      <h2 id="g-shop-title" class="t-display">From our farm</h2>
      <div class="g-cards" style={`--n:${related.length}`}>
        {related.map((p) => (
          <a class="p-card" href={link(`/shop/${p.slug}/`)} style={`--tone:${p.tone}`}>
            <div class="tile">
              {p.withComb && <span class="tag">With comb</span>}
              <Image src={img(p.card ?? p.photo)} alt="" widths={[420, 720]} sizes="(max-width: 760px) 80vw, 280px" />
            </div>
            <div class="meta">
              <h3>{p.name}</h3>
              <span class="arrow" aria-hidden="true"><Icon name="arrow-right" /></span>
            </div>
            <p>{p.status === 'paused' ? 'Not available right now' : p.kind}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="g-more wrap" aria-labelledby="g-more-title">
    <h2 id="g-more-title" class="t-display">More guides</h2>
    <ul>
      {others.map((o) => (
        <li>
          <a href={guideHref(o.slug)}>
            <span class="g-more-thumb"><Image src={img(o.image)} alt="" width={160} height={160} style={`object-position:${o.position ?? '50% 50%'}`} /></span>
            <span class="g-more-text"><span class="eyebrow">{o.eyebrow}</span><span class="g-more-name">{o.h1}</span></span>
            <span class="g-more-arrow" aria-hidden="true"><Icon name="arrow-right" /></span>
          </a>
        </li>
      ))}
    </ul>
    <a class="pill" href={link('/guides/')}>All guides</a>
  </section>
</Base>

<style>
  .g-head { display: grid; justify-items: center; gap: 18px; text-align: center; }
  .g-crumbs ol { display: flex; flex-wrap: wrap; justify-content: center; font-size: .86rem; color: var(--ink-3); }
  .g-crumbs li + li::before { content: "›"; margin: 0 .55em; }
  .g-crumbs a { color: var(--ink-2); text-decoration: none; }
  .g-crumbs a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .g-title { font-size: clamp(2.3rem, 6.2vw, 5.8rem); line-height: .95; max-width: 17ch; }
  .g-dek { max-width: 34ch; }
  .g-meta { font-size: .9rem; color: var(--ink-3); }
  .g-hero { margin-top: clamp(28px, 4vw, 56px); }
  .g-hero-photo { max-width: 1120px; margin-inline: auto; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: var(--cream-2); }
  .g-hero-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .g-body { padding-top: clamp(40px, 6vw, 90px); }

  /* minmax(0, 1fr): the card grid inside must never widen the column past the screen */
  .g-head, .g-shop, .g-more { grid-template-columns: minmax(0, 1fr); }
  .g-shop { display: grid; justify-items: center; gap: clamp(28px, 4vw, 48px); padding-top: clamp(70px, 9vw, 130px); text-align: center; }
  .g-cards { width: 100%; max-width: calc(var(--n) * 300px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: clamp(12px, 1.6vw, 22px); text-align: left; }

  .g-more { display: grid; justify-items: center; gap: 22px; padding-top: clamp(70px, 9vw, 130px); text-align: center; }
  .g-more ul { width: 100%; max-width: 760px; display: grid; gap: 10px; text-align: left; }
  .g-more li a { display: grid; grid-template-columns: 72px 1fr auto; gap: 16px; align-items: center; padding: 12px 18px 12px 12px; border-radius: 20px; background: var(--paper); border: 1px solid var(--rule); text-decoration: none; transition: background-color .3s; }
  .g-more li a:hover { background: var(--cream-2); }
  .g-more-thumb { display: block; width: 72px; height: 72px; border-radius: 14px; overflow: hidden; background: var(--cream-2); }
  .g-more-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .g-more-text { display: grid; gap: 4px; min-width: 0; }
  .g-more-text .eyebrow { font-size: .7rem; }
  .g-more-name { font-family: var(--f-display); font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.15; }
  .g-more-arrow { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--rule); transition: background-color .3s, transform .5s var(--ease); }
  .g-more-arrow :global(svg) { width: 18px; height: 18px; }
  .g-more li a:hover .g-more-arrow { background: var(--honey); border-color: var(--honey); transform: rotate(-45deg); }

  @media (max-width: 760px) {
    .g-hero-photo { aspect-ratio: 4 / 3; }
    .g-more li a { grid-template-columns: 60px 1fr; gap: 14px; padding-right: 14px; }
    .g-more-thumb { width: 60px; height: 60px; }
    .g-more-arrow { display: none; }
  }
</style>

<style is:global>
  /* article text (the slot is rendered by the page, so these rules are global, all under .prose) */
  .prose { max-width: 700px; margin-inline: auto; font-size: 1.125rem; line-height: 1.72; overflow-wrap: break-word; }
  .prose > * + * { margin-top: 1.15em; }
  .prose h2 { font-family: var(--f-display); font-weight: 500; font-size: clamp(1.75rem, 3.2vw, 2.45rem); line-height: 1.1; color: var(--choc); margin-top: 2.1em; text-wrap: balance; }
  .prose h3 { font-size: 1.22rem; font-weight: 700; line-height: 1.3; color: var(--cocoa); margin-top: 1.7em; }
  .prose h2 + *, .prose h3 + * { margin-top: .6em; }
  .prose p, .prose li { text-wrap: pretty; }
  .prose a { color: var(--honey-deep); font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .prose a:hover { color: var(--choc); }
  .prose strong { font-weight: 700; }
  .prose ul, .prose ol { padding-left: 1.35em; }
  .prose ul { list-style: disc; }
  .prose ol { list-style: decimal; }
  .prose li + li { margin-top: .5em; }
  .prose li::marker { color: var(--honey-deep); }
  .prose .g-note { padding: clamp(20px, 3vw, 30px); border-radius: var(--radius); background: var(--paper); border: 1px solid var(--rule); }
  .prose .g-note .eyebrow { margin-bottom: 8px; }
  .prose .g-note p + p { margin-top: .8em; }
  .prose .g-table { overflow-x: auto; }
  .prose table { width: 100%; border-collapse: collapse; font-size: 1rem; line-height: 1.45; }
  .prose th, .prose td { padding: 12px 12px 12px 0; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
  .prose thead th { font-size: .74rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
  .prose tbody th { font-weight: 700; color: var(--cocoa); }
  .prose .g-fig { margin-block: 2em; }
  .prose .g-fig-photo { aspect-ratio: 3 / 2; border-radius: var(--radius); overflow: hidden; background: var(--cream-2); }
  .prose .g-fig-photo img { width: 100%; height: 100%; object-fit: cover; }
  .prose .g-fig.tall { max-width: 440px; margin-inline: auto; }
  .prose .g-fig.tall .g-fig-photo { aspect-ratio: 4 / 5; }
  .prose .g-fig.square { max-width: 520px; margin-inline: auto; }
  .prose .g-fig.square .g-fig-photo { aspect-ratio: 1; }
  .prose figcaption { margin-top: 10px; font-family: var(--f-display); font-style: italic; font-size: 1rem; line-height: 1.4; color: var(--ink-2); }
  @media (max-width: 760px) {
    .prose { font-size: 1.0625rem; }
  }
</style>
