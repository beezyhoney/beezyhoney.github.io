{
  "name": "beezy-honey-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-catalog.mjs && astro dev",
    "build": "node scripts/sync-catalog.mjs && astro build && node scripts/check-dist.mjs",
    "build:e2e": "node scripts/sync-catalog.mjs && astro build --mode e2e && node scripts/check-dist.mjs --mode e2e",
    "preview": "astro preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "db:migrate:local": "node scripts/db-local.mjs migrate",
    "db:seed:local": "node scripts/db-local.mjs seed",
    "db:reset:local": "node scripts/db-local.mjs reset",
    "types": "wrangler types --env-file .dev.vars.example",
    "check-dist": "node scripts/check-dist.mjs",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "zero-diff": "node scripts/zero-diff.mjs",
    "catalog:pull": "node scripts/sync-catalog.mjs",
    "predeploy-check": "node scripts/predeploy-check.mjs",
    "deploy": "node scripts/predeploy-check.mjs && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.8",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/mukta-malar": "^5.3.0",
    "astro": "^7.4.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.7.0",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
